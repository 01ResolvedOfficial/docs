{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "01Resolved",
  "og": {
    "image": "/og-image.png"
  },
  "colors": {
    "primary": "#0A0A0A",
    "light": "#4A4A4A",
    "dark": "#0A0A0A"
  },
  "font": {
    "headings": {
      "family": "Open Sauce One"
    },
    "body": {
      "family": "Open Sauce One"
    }
  },
  "favicon": {
    "light": "/favicon-light.svg",
    "dark": "/favicon-dark.svg"
  },
  "custom": {
    "css": "/custom.css"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "width": 600,
    "href": "https://www.01resolved.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "index",
              "essentials/authentication",
              "essentials/rate-limits"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "essentials/core-concepts"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Project",
            "pages": [
              {
                "group": "Overview",
                "icon": "chart-bar",
                "pages": [
                  "api-reference/project/overview",
                  "api-reference/project/holders",
                  "api-reference/project/ico"
                ]
              },
              {
                "group": "Financials",
                "icon": "dollar-sign",
                "pages": [
                  "api-reference/project/financials",
                  "api-reference/project/assets",
                  "api-reference/project/token-supply",
                  "api-reference/project/revenue-expenses",
                  "api-reference/project/account-registry",
                  "api-reference/project/movements"
                ]
              },
              "api-reference/project/proposals"
            ]
          },
          {
            "group": "Ownership Coin Market",
            "pages": [
              "api-reference/ownership-coin-market/index",
              "api-reference/ownership-coin-market/launches",
              "api-reference/decision-markets/index",
              "api-reference/wallet-analytics"
            ]
          },
          {
            "group": "API Key",
            "pages": [
              "api-reference/api-key"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Recipes",
            "pages": [
              "guides/use-cases",
              "guides/nav-premium-discount"
            ]
          },
          {
            "group": "For Projects",
            "pages": [
              "guides/operating-performance"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "guides/project-slugs"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "01Resolved",
          "href": "https://www.01resolved.com",
          "icon": "chart-line"
        },
        {
          "anchor": "Telegram",
          "href": "https://t.me/Official01Resolved",
          "icon": "telegram"
        }
      ]
    }
  },
  "footer": {
    "socials": {
      "website": "https://www.01resolved.com",
      "x": "https://x.com/01Resolved",
      "telegram": "https://t.me/Official01Resolved"
    }
  },
  "redirects": [
    {
      "source": "/api-reference/dao",
      "destination": "/api-reference/project/financials"
    },
    {
      "source": "/api-reference/proposals",
      "destination": "/api-reference/project/proposals"
    },
    {
      "source": "/api-reference/trading-activity",
      "destination": "/api-reference/project/proposals"
    },
    {
      "source": "/api-reference/global-dashboard",
      "destination": "/api-reference/ownership-coin-market"
    },
    {
      "source": "/api-reference/project-overview",
      "destination": "/api-reference/project/overview"
    },
    {
      "source": "/api-reference/legal-entities",
      "destination": "/api-reference/project/overview"
    },
    {
      "source": "/api-reference/trader-details",
      "destination": "/api-reference/wallet-analytics"
    }
  ]
}
